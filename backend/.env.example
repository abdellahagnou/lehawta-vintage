# Lahwta Payment Server Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend URL (where your Lahwta store runs)
# Update this to match where you're running the frontend
FRONTEND_URL=http://localhost:3000

# ===== STRIPE CONFIGURATION =====
# Get your keys from: https://stripe.com/dashboard/apikeys
# 
# Test Keys (for development):
#   - Publishable Key: starts with pk_test_
#   - Secret Key: starts with sk_test_
#
# Live Keys (for production):
#   - Publishable Key: starts with pk_live_
#   - Secret Key: starts with sk_live_

# Your Stripe SECRET key (keep this private!)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Stripe webhook secret (optional, for handling events)
# Get from: Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ===== EMAIL CONFIGURATION =====
# For order confirmation emails
#
# Option 1: Gmail
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and "Windows Computer"
# 4. Generate App Password
# 5. Use that password below (not your regular Gmail password!)
#
# Option 2: Other Email Service
# Use service-specific SMTP credentials

EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password

# Where admin notifications go
ADMIN_EMAIL=your-email@gmail.com

# ===== DATABASE (Optional) =====
# For storing orders persistently
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/lahwta

# ===== SECURITY (For Production) =====
# CORS_ORIGIN=https://yourdomain.com
# SESSION_SECRET=generate-a-random-string-here
